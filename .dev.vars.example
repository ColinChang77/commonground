# Local development secrets (copy to .dev.vars). In production set each with `wrangler secret put NAME`.
ENVIRONMENT=development
APP_URL=http://localhost:3100
# 32+ random bytes: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# 32 random bytes, base64: `openssl rand -base64 32` — encrypts stored agent API keys (AES-256-GCM)
CREDENTIAL_ENCRYPTION_KEY=

# Email (Resend). Required in production for verification + password reset.
RESEND_API_KEY=
EMAIL_FROM="CommonGround <hello@your-domain>"

# Optional OAuth sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub App's OAuth credentials (the same GitHub App handles sign-in and repo access)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App (docs/GITHUB_APP.md)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PKCS#8 PEM, newlines as \n. Convert GitHub's key: openssl pkcs8 -topk8 -nocrypt -in key.pem
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Analytics (optional)
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Realtime service (realtime/). Must equal the realtime worker secret.
REALTIME_SECRET=
REALTIME_URL=http://localhost:8790
